{
  "name": "safar",
  "version": "1.0.0",
  "description": "A small API for tracking my job applications",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Aditya Chandra Prajapati",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
